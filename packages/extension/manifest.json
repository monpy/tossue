{
  "manifest_version": 3,
  "name": "Tossue",
  "version": "0.1.0",
  "description": "Collects structured debugging context and drafts GitHub issues for AI-assisted bug fixing.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "identity",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:47321/*",
    "https://api.github.com/*"
  ],
  "oauth2": {
    "client_id": "Ov23lijpKUqzLGK1HMCo",
    "scopes": ["repo"]
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Tossue"
  },
  "devtools_page": "src/devtools/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/styles/global.css", "src/content/injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
