{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tossue Helper",
  "version": "0.1.0",
  "identifier": "com.monpy.tossue.helper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tossue Helper",
        "width": 640,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
