{
  "manifest_version": 3,
  "name": "Tossue",
  "version": "0.1.0",
  "description": "Collects structured debugging context and drafts GitHub issues for AI-assisted bug fixing.",
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Tossue"
  },
  "devtools_page": "src/devtools/index.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/styles/global.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
